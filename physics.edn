;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:dev:physics` runs it.
;;
;; README "Robotics premise": a cash-handling robot manages physical
;; currency/chip custody under the actor, gated by the Responsible Gambling
;; Governor (ISIC 9200 gambling and betting). Its physical work is moving
;; money: pushing a drop-box cart from the gaming floor up the ramp into the
;; count room, and lifting sealed coin bags / chip racks into the vault safe.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-9200"
 :cases
 [{:id :drop-box-cart-to-count-room
   :kind :transport
   :procedure "cash-handling robot pushes the drop-box cart from the gaming floor up the ramp into the count room"
   :params {:mass-kg 60.0 :distance-m 80.0 :v-max-mps 1.0 :a-max-mps2 0.5
            :brake-decel-mps2 0.8 :drive-force-n 150.0 :crr 0.015 :slope-deg 4.8
            :cog-height-m 0.50 :support-half-length-m 0.30 :payload-cog-height-m 0.80
            :max-time-s 1800.0}
   :sweep {:param :payload-kg :values [20.0 40.0 60.0 80.0 100.0]}
   :quantity :cycle-time-s
   :limit {:max 120.0 :basis "estimate: one floor-to-count-room leg within a two-minute escorted drop window; 4.8 deg is the 1:12 accessible-ramp slope"}
   :boundary {:lo 20.0 :hi 200.0}}
  {:id :coin-bag-into-vault
   :kind :manipulator
   :procedure "arm lifts a sealed coin bag from the cart deck onto the vault safe shelf"
   :params {:l1-m 0.50 :l2-m 0.45 :m1-kg 5.0 :m2-kg 3.5
            :from [0.60 0.05] :to [0.30 0.75] :duration-s 3.0 :steps 500}
   :sweep {:param :payload-kg :values [2.0 5.0 8.0 12.0 16.0]}
   :quantity :peak-tau1-nm
   :limit {:max 150.0 :basis "estimate: continuous shoulder torque of a 10 kg-class collaborative arm"}
   :boundary {:lo 0.5 :hi 40.0}}]}
